        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Main support column    |    W8×24, A36 per drawing    |    Support drawing</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="26" left="36" top="679" width="540" height="28" align-x="36" align-y="707" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Cantilever member    |    HSS 4×4×1/2 in, ASTM A500 Grade B    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="27" left="36" top="710" width="540" height="14" align-x="36" align-y="724" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS modulus of elasticity, E    |    29,000 ksi    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="28" left="36" top="727" width="540" height="14" align-x="36" align-y="741" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS yield strength, Fy    |    46 ksi    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="29" left="36" top="744" width="540" height="14" align-x="36" align-y="758" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS section modulus, S    |    5.97 in³    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="30" left="36" top="761" width="540" height="14" align-x="36" align-y="775" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS moment of inertia, I    |    11.9 in⁴    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="31" left="36" top="778" width="540" height="14" align-x="36" align-y="792" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS area, A    |    6.02 in²    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="32" left="36" top="795" width="540" height="14" align-x="36" align-y="809" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS design wall thickness    |    0.465 in    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="33" left="36" top="812" width="540" height="28" align-x="36" align-y="840" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Load lever arm, L    |    14 in from W8×24 column centerline to pipe centerline    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="34" left="36" top="843" width="540" height="14" align-x="36" align-y="857" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Pipe clamp    |    Fig. 295N double-bolt pipe clamp    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="35" left="36" top="860" width="540" height="28" align-x="36" align-y="888" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Hanger components    |    Fig. 290-LN eye nut; Fig. 140N threaded rod; Fig. 299N clevis; Fig. 55N welding lug    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="36" left="36" top="891" width="540" height="28" align-x="36" align-y="919" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS-to-W8 weld    |    1/4 in all-around fillet weld; E70XX electrode    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="37" left="36" top="922" width="540" height="14" align-x="36" align-y="936" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">W8×24 flange thickness, t    |    0.40 in    |    Reference calculation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="38" left="36" top="939" width="540" height="28" align-x="36" align-y="967" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Baseplate/anchors shown on drawing    |    Four 1/2 in Hilti KB-TZ2 anchors; 2-1/2 in nominal embedment    |    Support drawing</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="39" left="36" top="970" width="540" height="19" align-x="36" align-y="989" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3.1 Load interpretation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="40" left="36" top="992" width="540" height="56" align-x="36" align-y="1048" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">For this review, 3,100 lb is treated as the total revised vertical support load, not as an additional load applied on top of the existing drawing loads. The reference calculation uses a 3.1 kip vertical force at a 14 in lever arm for the HSS cantilever check.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="41" left="36" top="1051" width="540" height="42" align-x="36" align-y="1093" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The supplied excerpts do not show other support reaction components or load combinations. Confirm the applicable piping reactions and governing load combinations against the current controlled procedures and piping analysis.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="42" left="36" top="1096" width="540" height="22" align-x="36" align-y="1118" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Subtitle" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4. Calculation and evaluation</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="43" left="36" top="1121" width="540" height="19" align-x="36" align-y="1140" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4.1 Revised load comparison</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="44" left="36" top="1143" width="540" height="14" align-x="36" align-y="1157" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Increase over the drawing hot load:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="45" left="36" top="1160" width="540" height="14" align-x="36" align-y="1174" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3,100 − 2,325 = 775 lb</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="46" left="36" top="1177" width="540" height="14" align-x="36" align-y="1191" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3,100 / 2,325 = 1.333 → 33.3% above the hot load</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="47" left="36" top="1194" width="540" height="14" align-x="36" align-y="1208" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Increase over the drawing cold load:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="48" left="36" top="1211" width="540" height="14" align-x="36" align-y="1225" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3,100 − 1,739 = 1,361 lb</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="49" left="36" top="1228" width="540" height="14" align-x="36" align-y="1242" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3,100 / 1,739 = 1.782 → 78.2% above the cold load</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="50" left="36" top="1245" width="540" height="19" align-x="36" align-y="1264" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4.2 Pipe-support assembly</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="51" left="36" top="1267" width="540" height="28" align-x="36" align-y="1295" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The reference calculation compares the 3,100 lb applied load to catalog allowable vertical loads:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="52" left="36" top="1298" width="540" height="14" align-x="36" align-y="1312" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Component    |    Allowable load (lb)    |    Interaction ratio, P / allowable</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="53" left="36" top="1315" width="540" height="14" align-x="36" align-y="1329" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fig. 295N double-bolt pipe clamp    |    3,240    |    3,100 / 3,240 = 0.957</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="54" left="36" top="1332" width="540" height="14" align-x="36" align-y="1346" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fig. 290-LN weldless eye nut    |    3,770    |    3,100 / 3,770 = 0.822</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="55" left="36" top="1349" width="540" height="14" align-x="36" align-y="1363" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fig. 140N threaded rod    |    3,770    |    3,100 / 3,770 = 0.822</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="56" left="36" top="1366" width="540" height="14" align-x="36" align-y="1380" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fig. 299N forged steel clevis    |    3,770    |    3,100 / 3,770 = 0.822</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="57" left="36" top="1383" width="540" height="14" align-x="36" align-y="1397" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fig. 55N welding lug    |    3,770    |    3,100 / 3,770 = 0.822</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="58" left="36" top="1400" width="540" height="14" align-x="36" align-y="1414" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The clamp governs:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="59" left="36" top="1417" width="540" height="14" align-x="36" align-y="1431" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IRassembly = 3,100 / min(3,240, 3,770, 3,770, 3,770, 3,770) = 0.957 ≈ 0.96</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="60" left="36" top="1434" width="540" height="42" align-x="36" align-y="1476" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Reference result: IRassembly &lt; 1.0 — reported O.K. The clamp has 140 lb of nominal allowable-load margin. Confirm the exact component models, installation configuration, and current catalog allowables.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="61" left="36" top="1479" width="540" height="19" align-x="36" align-y="1498" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4.3 HSS cantilever bending</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="62" left="36" top="1501" width="540" height="14" align-x="36" align-y="1515" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Applied moment at the HSS:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="63" left="36" top="1518" width="540" height="14" align-x="36" align-y="1532" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Mz = P × L = 3.1 kip × 14 in = 43.4 kip-in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="64" left="36" top="1535" width="540" height="14" align-x="36" align-y="1549" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Maximum bending stress:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="65" left="36" top="1552" width="540" height="14" align-x="36" align-y="1566" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">fb = Mz / S = 43.4 kip-in / 5.97 in³ = 7.27 ksi</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="66" left="36" top="1569" width="540" height="14" align-x="36" align-y="1583" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Allowable bending stress used in the reference:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="67" left="36" top="1586" width="540" height="14" align-x="36" align-y="1600" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fb,allow = 0.6 × Fy = 0.6 × 46 ksi = 27.6 ksi</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="68" left="36" top="1603" width="540" height="14" align-x="36" align-y="1617" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Bending interaction ratio:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="69" left="36" top="1620" width="540" height="14" align-x="36" align-y="1634" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IRbending = fb / Fb,allow = 7.27 / 27.6 = 0.264 ≈ 0.26</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="70" left="36" top="1637" width="540" height="14" align-x="36" align-y="1651" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Reference result: IRbending &lt; 1.0 — reported O.K.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="71" left="36" top="1654" width="540" height="56" align-x="36" align-y="1710" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The reference calculation states that shear is not governing but the supplied excerpt does not show a numeric shear ratio. It also states that vertical deflection was evaluated; the numeric deflection and acceptance limit are not visible in the supplied excerpts and require confirmation in the complete calculation.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="72" left="36" top="1713" width="540" height="19" align-x="36" align-y="1732" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4.4 HSS-to-W8 weld</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="73" left="36" top="1735" width="540" height="28" align-x="36" align-y="1763" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The reference checks the all-around 1/4 in fillet weld for combined direct shear and bending:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="74" left="36" top="1766" width="540" height="14" align-x="36" align-y="1780" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Quantity    |    Reference value</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="75" left="36" top="1783" width="540" height="14" align-x="36" align-y="1797" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Weld-group length, Lw    |    14.3 in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="76" left="36" top="1800" width="540" height="14" align-x="36" align-y="1814" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Weld-group section modulus, Sw    |    17.4 in³</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="77" left="36" top="1817" width="540" height="14" align-x="36" align-y="1831" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Weld force per unit length, X direction    |    2.49 kip/in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="78" left="36" top="1834" width="540" height="14" align-x="36" align-y="1848" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Weld force per unit length, Y direction    |    0.22 kip/in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="79" left="36" top="1851" width="540" height="14" align-x="36" align-y="1865" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Combined applied weld force per unit length    |    2.50 kip/in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="80" left="36" top="1868" width="540" height="14" align-x="36" align-y="1882" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Allowable E70XX weld force per unit length    |    3.71 kip/in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="81" left="36" top="1885" width="540" height="14" align-x="36" align-y="1899" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Allowable base-metal force per unit length    |    5.76 kip/in</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="82" left="36" top="1902" width="540" height="14" align-x="36" align-y="1916" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">The governing allowable is the lesser of the weld-metal and base-metal values:</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="83" left="36" top="1919" width="540" height="14" align-x="36" align-y="1933" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">IRweld = 2.50 / min(3.71, 5.76) = 0.674 ≈ 0.67</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="84" left="36" top="1936" width="540" height="14" align-x="36" align-y="1950" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Reference result: IRweld &lt; 1.0 — reported O.K.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="85" left="36" top="1953" width="540" height="22" align-x="36" align-y="1975" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Subtitle" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">5. Summary of results</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="86" left="36" top="1978" width="540" height="14" align-x="36" align-y="1992" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Check    |    Demand / capacity result    |    Status in supplied reference</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="87" left="36" top="1995" width="540" height="28" align-x="36" align-y="2023" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Pipe-support assembly    |    Governing ratio = 0.96 (pipe clamp)    |    O.K.; least margin of the checks shown</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="88" left="36" top="2026" width="540" height="14" align-x="36" align-y="2040" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS cantilever bending    |    Ratio = 0.26    |    O.K.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="89" left="36" top="2043" width="540" height="14" align-x="36" align-y="2057" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS shear    |    Numeric ratio not shown    |    Stated non-governing</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="90" left="36" top="2060" width="540" height="28" align-x="36" align-y="2088" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS vertical deflection    |    Numeric result/limit not supplied    |    Confirmation required</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="91" left="36" top="2091" width="540" height="14" align-x="36" align-y="2105" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">HSS-to-W8 weld    |    Ratio = 0.67    |    O.K.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="92" left="36" top="2108" width="540" height="28" align-x="36" align-y="2136" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Baseplate and anchors    |    Appendix A analysis results not supplied    |    Not verified in this review</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="93" left="36" top="2139" width="540" height="28" align-x="36" align-y="2167" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Concrete anchorage and slab    |    Design inputs/results not supplied    |    Not verified in this review</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="94" left="36" top="2170" width="540" height="28" align-x="36" align-y="2198" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Required load combinations    |    Not established by supplied excerpts    |    Confirm against current procedures/piping analysis</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="95" left="36" top="2201" width="540" height="22" align-x="36" align-y="2223" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Subtitle" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">6. Conclusion</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="96" left="36" top="2226" width="540" height="56" align-x="36" align-y="2282" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">For the 3,100 lb vertical load and assumptions shown in the supplied reference calculation, the reported utilization ratios are 0.96 for the pipe-support assembly, 0.26 for HSS bending, and 0.67 for the HSS-to-W8 weld. These listed ratios are below 1.0; the pipe clamp is the governing listed component.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="97" left="36" top="2285" width="540" height="98" align-x="36" align-y="2383" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">This conclusion applies only to the checks and assumptions visible in the supplied excerpts. The reference calculation identifies baseplate/anchor results in Appendix A, but that appendix and the numeric deflection result were not provided. Therefore, this training review does not establish overall support adequacy or authorize design release or field use. Confirm the complete controlled calculation, anchor/baseplate/concrete checks, deflection, applicable load combinations, component ratings, and required qualified review before any engineering use.</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="98" left="36" top="2386" width="540" height="22" align-x="36" align-y="2408" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Subtitle" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">7. Training review record</ws:p>
      </ws:text>
    </ws:region>
