        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Existing hot vertical load    |    2,325 lb    |    Support drawing</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="24" left="36" top="645" width="540" height="14" align-x="36" align-y="659" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
      <ws:text use-page-width="false" push-down="false" lock-width="true">
        <ws:p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Existing cold vertical load    |    1,739 lb    |    Support drawing</ws:p>
      </ws:text>
    </ws:region>
    <ws:region region-id="25" left="36" top="662" width="540" height="14" align-x="36" align-y="676" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
